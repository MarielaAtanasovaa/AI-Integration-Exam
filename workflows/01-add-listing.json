      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst safe = (s) => String(s || '').replace(/[^a-zA-Z0-9._-]/g, '_');\nconst out = {\n  title: body.title,\n  property_type: body.property_type,\n  listing_type: body.listing_type,\n  location: body.location,\n  price: Number(body.price),\n  description: body.description,\n  hasImage: false,\n  objectName: null,\n  imageUrl: null,\n  mimeType: null\n};\nconst result = { json: out };\nconst img = body.image;\nif (img && img.base64) {\n  const objectName = Date.now() + '_' + safe(img.filename || 'image');\n  out.hasImage = true;\n  out.objectName = objectName;\n  out.mimeType = img.mimeType || 'application/octet-stream';\n  out.imageUrl = $env.SUPABASE_URL + '/storage/v1/object/public/property-images/' + objectName;\n  result.binary = { data: { data: img.base64, mimeType: out.mimeType, fileName: objectName } };\n}\nreturn [result];"
      },
