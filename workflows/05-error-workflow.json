{
  "name": "NovaDom - Error Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "41997015-e7ce-4460-a492-0636a8ff9552",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst wf = e.workflow ? e.workflow.name : 'unknown';\nconst node = e.execution && e.execution.lastNodeExecuted ? e.execution.lastNodeExecuted : (e.node ? e.node.name : 'unknown');\nconst message = (e.execution && e.execution.error && e.execution.error.message) || (e.error && e.error.message) || 'Unknown error';\nreturn [{ json: { workflow_name: wf, node_name: node, message } }];"
      },
      "id": "5c91eb15-46a1-442b-a25d-22c514769b96",
      "name": "Format Error",
