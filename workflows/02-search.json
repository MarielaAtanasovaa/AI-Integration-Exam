    {
      "parameters": {
        "jsCode": "const THRESHOLD = 0.70;\nconst query = $('Webhook').first().json.body.query;\nconst rows = items.map(i => i.json).filter(r => r && typeof r.similarity === 'number');\nconst good = rows.filter(r => r.similarity >= THRESHOLD);\nif (good.length === 0) {\n  return [{ json: { matches: [], message: 'No listings closely match your search. Try different wording.', buyer_query: query, matched_property_ids: [] } }];\n}\nconst matches = good.map(r => ({\n  id: r.metadata.property_id,\n  title: r.metadata.title,\n  property_type: r.metadata.property_type,\n  listing_type: r.metadata.listing_type,\n  location: r.metadata.location,\n  price: r.metadata.price,\n  image_url: r.metadata.image_url || null,\n  description: r.content,\n  similarity: r.similarity\n}));\nreturn [{ json: { matches, message: '', buyer_query: query, matched_property_ids: matches.map(m => m.id) } }];"
      },
      "id": "a4e071f6-cdd2-46c1-a6a0-bdb645e2a074",
