# Copy to n8n/.env and fill in. docker-compose reads this file automatically.

# Google AI Studio key (used by the HTTP embedding calls and Gemini credentials)
GEMINI_API_KEY=your-google-ai-studio-key

# Supabase project REST base URL — NO trailing slash
SUPABASE_URL=https://dvowzaavjqakjehmgbmq.supabase.co

# Supabase service-role key (Project Settings → API → service_role). Server-side only.
SUPABASE_SERVICE_KEY=your-service-role-key
